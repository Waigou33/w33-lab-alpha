 ObExprTokenize::~ObExprTokenize() {}
 
+namespace
+{
+
+// TOKENIZE() maps the user supplied parser name (e.g. "ik") to the serialized inner name
+// ("<name>.<plugin version>", e.g. "ik.1") by looking the parser up in the plugin
+// registry and formatting the result with databuff_printf. The mapping is a pure function
+// of the input string while the server is running (builtin ft parsers are registered once
+// at bootstrap and are never hot swapped), so it is memoized per thread.
+//
+// Safety rules that keep this cache harmless:
+//   1. only the *serialized name* is cached, never any per call state (no datum, no
+//      collation, no allocator, no iterator);
+//   2. an entry is written at most once - a full table simply stops caching, so a pointer
+//      handed out by a previous hit can never be overwritten by a later call;
+//   3. any unusual input (empty string, oversize result) is not cached at all and falls
+//      back to the original code path;
+//   4. the table lives in thread_local static storage with a trivial destructor, so there
+//      is no lock, no cross thread sharing and no destruction order hazard at thread exit.
+constexpr int64_t MAX_TOKENIZE_PARSER_MEMO_ENTRY = 8;
+
+struct ObTokenizeParserMemoEntry
+{
+  bool used_;
+  int64_t src_len_;
+  char src_[OB_PLUGIN_NAME_LENGTH];   // raw parser name supplied by the user
+  int64_t dst_len_;
+  char dst_[OB_PLUGIN_NAME_LENGTH];   // serialized inner parser name "name.version"
+};
+
+struct ObTokenizeParserMemo
+{
+  ObTokenizeParserMemoEntry entries_[MAX_TOKENIZE_PARSER_MEMO_ENTRY];
+};
+
+ObTokenizeParserMemo &get_tokenize_parser_memo()
+{
+  // zero initialized, trivially destructible: safe for thread exit.
+  static thread_local ObTokenizeParserMemo memo;
+  return memo;
+}
+
+bool find_tokenize_parser_memo(ObTokenizeParserMemo &memo,
+                               const char *src,
+                               const int64_t src_len,
+                               const char *&dst,
+                               int64_t &dst_len)
+{
+  bool hit = false;
+  dst = nullptr;
+  dst_len = 0;
+  if (OB_NOT_NULL(src) && src_len > 0 && src_len < OB_PLUGIN_NAME_LENGTH) {
+    for (int64_t i = 0; !hit && i < MAX_TOKENIZE_PARSER_MEMO_ENTRY; ++i) {
+      const ObTokenizeParserMemoEntry &entry = memo.entries_[i];
+      if (entry.used_ && entry.src_len_ == src_len && 0 == MEMCMP(entry.src_, src, src_len)) {
+        dst = entry.dst_;
+        dst_len = entry.dst_len_;
+        hit = true;
+      }
+    }
+  }
+  return hit;
+}
+
+void add_tokenize_parser_memo(ObTokenizeParserMemo &memo,
+                              const char *src,
+                              const int64_t src_len,
+                              const char *dst,
+                              const int64_t dst_len)
+{
+  if (OB_ISNULL(src) || OB_ISNULL(dst)
+      || src_len <= 0 || src_len >= OB_PLUGIN_NAME_LENGTH
+      || dst_len <= 0 || dst_len >= OB_PLUGIN_NAME_LENGTH) {
+    // not cacheable, silently keep the uncached behaviour.
+  } else {
+    for (int64_t i = 0; i < MAX_TOKENIZE_PARSER_MEMO_ENTRY; ++i) {
+      ObTokenizeParserMemoEntry &entry = memo.entries_[i];
+      if (!entry.used_) {
+        MEMCPY(entry.src_, src, src_len);
+        MEMCPY(entry.dst_, dst, dst_len);
+        entry.src_[src_len] = '\0';
+        entry.dst_[dst_len] = '\0';
+        entry.src_len_ = src_len;
+        entry.dst_len_ = dst_len;
+        entry.used_ = true;
+        break;
+      }
+    }
+    // table is full: do nothing, the caller already has a valid uncached result.
+  }
+}
+
+} // anonymous namespace
