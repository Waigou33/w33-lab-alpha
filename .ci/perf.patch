+    // call below, with the same type, so returning it is indistinguishable from doing the
+    // lookup (only cheaper, and free of the linear scan of MY_SPEC.output_).
+    expr = fts_col_exprs_[idx];
+  } else if (OB_FAIL(get_output_fts_col_expr_by_type(type, expr))) {
+    LOG_WARN("fail to get fts column expr by type", K(ret), K(idx), "type", get_type_name(type));
+  }
+  return ret;
+}
