+int ObFTWordRowScratch::ensure_word_map(const int64_t bucket_cnt)
+{
+  int ret = OB_SUCCESS;
+  if (OB_UNLIKELY(bucket_cnt <= 0)) {
+    ret = OB_INVALID_ARGUMENT;
+    LOG_WARN("invalid bucket count", K(ret), K(bucket_cnt));
+  } else if (!word_map_.created()) {
+    // Same call, same label as the per-document map of the old code, so the map behaves
+    // identically; only its lifetime changed.
+    if (OB_FAIL(word_map_.create(bucket_cnt, common::ObMemAttr("FTWordMap")))) {
+      LOG_WARN("fail to create ft word map", K(ret), K(bucket_cnt));
+    } else {
+      word_map_bkt_cnt_ = bucket_cnt;
+    }
+  } else if (bucket_cnt > word_map_bkt_cnt_) {
+    // Grow only. Never shrinking keeps the current document with at least as many buckets
+    // as the per-document create() would have given it, so hash chains stay as short as
+    // before; the (word -> count) content of a hash map does not depend on bucket_num_.
+    if (OB_FAIL(word_map_.destroy())) {
+      LOG_WARN("fail to destroy ft word map", K(ret), K_(word_map_bkt_cnt), K(bucket_cnt));
+    } else {
+      word_map_bkt_cnt_ = 0;
+      if (OB_FAIL(word_map_.create(bucket_cnt, common::ObMemAttr("FTWordMap")))) {
+        LOG_WARN("fail to re-create ft word map", K(ret), K(bucket_cnt));
+      } else {
+        word_map_bkt_cnt_ = bucket_cnt;
+      }
+    }
+  } else {
+    // Keep the existing bucket array; ObFTParseHelper::segment() clears the content
+    // (words.reuse()) before inserting this document's first word.
+  }
+  return ret;
+}
+
+int ObFTWordRowScratch::ensure_row_buffer(const int64_t row_cnt, blocksstable::ObDatumRow *&rows)
+{
+  int ret = OB_SUCCESS;
+  rows = nullptr;
+  if (OB_UNLIKELY(row_cnt <= 0)) {
+    // unreachable: the caller only asks for a buffer when word_map.size() > 0
+    ret = OB_INVALID_ARGUMENT;
+    LOG_WARN("invalid row count", K(ret), K(row_cnt));
+  } else if (row_cnt > row_cap_) {
+    // Geometric growth: a scan whose documents grow in size allocates O(log n) times.
+    int64_t new_cap = row_cap_;
+    while (new_cap < row_cnt) {
+      new_cap = (new_cap < FT_WORD_ROW_BUFFER_MIN_CAPACITY) ? FT_WORD_ROW_BUFFER_MIN_CAPACITY : new_cap * 2;
+    }
+    void *rows_buf = nullptr;
+    if (OB_ISNULL(rows_buf = row_allocator_.alloc(new_cap * sizeof(blocksstable::ObDatumRow)))) {
+      ret = OB_ALLOCATE_MEMORY_FAILED;
+      LOG_WARN("failed to alloc memory for reusable full text index rows buffer",
+               K(ret), K(new_cap), K(row_cnt));
+    } else {
+      blocksstable::ObDatumRow *new_rows = new (rows_buf) blocksstable::ObDatumRow[new_cap];
+      // init() once per row and never again (it reports OB_INIT_TWICE on a valid row);
+      // the column count of a fulltext row is constant, so a row stays valid for as long
+      // as its buffer lives and only its content is rewritten per document.
+      for (int64_t i = 0; OB_SUCC(ret) && i < new_cap; ++i) {
+        if (OB_FAIL(new_rows[i].init(row_allocator_, FT_WORD_DOC_COL_CNT))) {
+          LOG_WARN("init datum row failed", K(ret), K(i), K(FT_WORD_DOC_COL_CNT));
+        }
+      }
+      if (OB_SUCC(ret)) {
+        // The previous buffer is intentionally not freed: row_allocator_ is an arena and
+        // only reset() returns its pages, so the waste is bounded by the geometric growth
+        // (at most ~2x the final capacity).
+        row_buf_ = new_rows;
+        row_cap_ = new_cap;
+      }
+    }
+  }
+  if (OB_SUCC(ret)) {
+    rows = row_buf_;
+  }
+  return ret;
+}
+
+void ObFTWordRowScratch::reset()
+{
+  if (word_map_.created()) {
+    // destroy() hands every node back to the map's own node allocator and frees the
+    // bucket array, so nothing of this map outlives reset().
+    const int tmp_ret = word_map_.destroy();
+    if (OB_SUCCESS != tmp_ret) {
+      LOG_WARN("fail to destroy ft word map", K(tmp_ret));
+    }
+  }
+  word_map_bkt_cnt_ = 0;
+  // ObDatumRow::reset() (public API, idempotent) drops what a row holds -- its datum
+  // buffer is the row's inline array, so this only clears it -- and then the arena
+  // releases the row buffer itself. No per-row operator delete is involved.
+  for (int64_t i = 0; OB_NOT_NULL(row_buf_) && i < row_cap_; ++i) {
+    row_buf_[i].reset();
+  }
+  row_buf_ = nullptr;
+  row_cap_ = 0;
+  row_allocator_.reset();
+}
