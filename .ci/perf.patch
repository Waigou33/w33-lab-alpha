+// Reusable per-document buffers for fulltext word row generation.
+//
+// Why it exists: generate_fulltext_word_rows() runs once per document, and one fulltext
+// index build segments every document twice (the fts_index_aux table and the
+// __fts_doc_word_aux table each scan the base table), so anything that is allocated per
+// call is allocated for every (document, aux table) pair. One instance of this class is
+// owned by ObFTIndexRowCache, i.e. by one table scan operator, and the buffers below only
+// ever grow -- a document reuses the memory of its predecessor.
+//
+// Why the produced rows are still exactly "this document's rows":
+//   1) the token map is emptied by ObFTParseHelper::segment() (words.reuse() ->
+//      ObHashMap::reuse() -> ObHashTable::clear()) before the first word of the current
+//      document is inserted, so no word of a previous document can reach the row loop;
+//   2) the row buffer is not a cache of results: every row handed to the caller is first
+//      cleared with ObDatumRow::reuse() and all four of its columns are then overwritten
+//      unconditionally, and the caller only receives word_map.size() rows of the current
+//      document -- neither a stale datum nor a stale row count can survive;
+//   3) a row's datums live in ObDatumRow::datum_buffer_'s inline array
+//      (FT_WORD_DOC_COL_CNT(=4) <= ObStorageDatumBuffer's inline capacity), i.e. inside
+//      the ObDatumRow object itself, so they travel with the buffer and can never point
+//      into memory that has been released;
+//   4) row_allocator_ is NOT the per-document parser arena: ObFTIndexRowCache::reuse()
+//      resets merge_memctx_ for every document, which would invalidate a buffer that had
+//      been allocated from it.
+class ObFTWordRowScratch final
+{
+public:
+  // number of columns of one fulltext word/index row: [WORD|DOC_ID], [DOC_ID|WORD],
+  // [WORD_COUNT], [DOC_LENGTH]
+  static const int64_t FT_WORD_DOC_COL_CNT = 4;
+  // first row buffer is at least this large, later ones grow by doubling
+  static const int64_t FT_WORD_ROW_BUFFER_MIN_CAPACITY = 32;
+
+  ObFTWordRowScratch();
+  ~ObFTWordRowScratch() { reset(); }
+  // Creates the token map of the current document. The map is only (re)created when the
+  // current document needs more buckets than the map has; otherwise the existing bucket
+  // array is reused, which cannot change the produced (word -> count) content because a
+  // hash map's content does not depend on its bucket count or on its history.
+  int ensure_word_map(const int64_t bucket_cnt);
+  // Grow-only: returns a buffer holding at least row_cnt rows, each already inited with
+  // FT_WORD_DOC_COL_CNT columns. The content of the returned rows is meaningless, callers
+  // must (re)fill every column.
+  int ensure_row_buffer(const int64_t row_cnt, blocksstable::ObDatumRow *&rows);
+  // Releases the map and the row arena. Idempotent.
+  void reset();
+  OB_INLINE storage::ObFTWordMap &get_word_map() { return word_map_; }
+private:
+  common::ObArenaAllocator row_allocator_;
+  storage::ObFTWordMap word_map_;
+  blocksstable::ObDatumRow *row_buf_;
+  int64_t row_cap_;
+  int64_t word_map_bkt_cnt_;
+
+  DISALLOW_COPY_AND_ASSIGN(ObFTWordRowScratch);
+};
