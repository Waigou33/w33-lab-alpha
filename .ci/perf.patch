+/**
+ * One resolved ft parser plugin, see ObPluginHelper::find_ftparser_cached() for why the
+ * pointers may be memoized.
+ */
+struct ObFTParserCacheEntry
+{
+  ObFTParserCacheEntry()
+    : valid_(false), name_len_(0), ftparser_(nullptr), param_(nullptr), library_version_(-1)
+  {
+    MEMSET(name_, '\0', OB_PLUGIN_NAME_MAX_LENGTH);
+  }
+  bool valid_;
+  int64_t name_len_;
+  char name_[OB_PLUGIN_NAME_MAX_LENGTH];
+  ObIFTParserDesc *ftparser_;
+  ObPluginParam *param_;
+  int64_t library_version_;
+};
+
+constexpr int64_t FT_PARSER_CACHE_CAPACITY = 16;
+
+/**
+ * Process level, read mostly cache of resolved ft parser plugins.
+ * @details entries are only appended on a cache miss and are never modified once
+ *   published, the lock only protects the append and keeps the reader from observing a
+ *   half written entry. When the cache is full we simply fall back to the normal lookup,
+ *   so the cache can never change the result of a lookup, only its cost.
+ */
+struct ObFTParserCache
+{
+  ObFTParserCache() : count_(0) {}
+  common::ObSpinLock lock_;
+  int64_t count_;
+  ObFTParserCacheEntry entries_[FT_PARSER_CACHE_CAPACITY];
+};
+
+ObFTParserCache &get_ft_parser_cache()
+{
+  static ObFTParserCache cache;
+  return cache;
+}
+
+} // namespace
+
+int ObPluginHelper::find_ftparser_cached(const ObString &parser_name,
+                                         ObIFTParserDesc *&ftparser,
+                                         ObPluginParam *&param,
+                                         int64_t &library_version)
+{
+  int ret = OB_SUCCESS;
+  ftparser = nullptr;
+  param = nullptr;
+  library_version = -1;
+
+  ObFTParserCache &cache = get_ft_parser_cache();
+  const int64_t name_len = static_cast<int64_t>(parser_name.length());
+  bool found = false;
+  {
+    common::ObSpinLockGuard guard(cache.lock_);
+    for (int64_t i = 0; !found && i < cache.count_; ++i) {
+      const ObFTParserCacheEntry &entry = cache.entries_[i];
+      // byte exact compare: the plugin manager matches names case insensitively, but the
+      // name is also carried around by the callers, so we keep the key byte exact to be
+      // on the safe side and to never mix up two spellings.
+      if (entry.valid_ && entry.name_len_ == name_len
+          && 0 == MEMCMP(entry.name_, parser_name.ptr(), name_len)) {
+        ftparser = entry.ftparser_;
+        param = entry.param_;
+        library_version = entry.library_version_;
+        found = true;
+      }
+    }
+  }
+
+  if (!found) {
+    ObPluginEntryHandle *entry_handle = nullptr;
+    if (OB_FAIL(find_ftparser_entry(parser_name, entry_handle))) {
+      if (OB_FUNCTION_NOT_DEFINED == ret) {
+        LOG_USER_ERROR(OB_FUNCTION_NOT_DEFINED, parser_name.length(), parser_name.ptr());
+        LOG_DEBUG("no such parser", K(parser_name));
+      } else {
+        LOG_WARN("failed to find ftparser", K(parser_name), K(ret));
+      }
+    } else if (OB_ISNULL(entry_handle->entry().plugin_handle)) {
+      ret = OB_ERR_UNEXPECTED;
+      LOG_WARN("find a plugin entry without plugin handle", K(ret), KPC(entry_handle));
+    } else {
+      ftparser = reinterpret_cast<ObIFTParserDesc *>(entry_handle->entry().descriptor);
+      param = &entry_handle->entry().plugin_handle->plugin_param();
+      library_version = static_cast<int64_t>(entry_handle->library_version());
+      LOG_TRACE("find ftparser plugin", K(parser_name), K(library_version));
+      if (name_len > 0 && name_len < OB_PLUGIN_NAME_MAX_LENGTH) {
+        common::ObSpinLockGuard guard(cache.lock_);
+        if (cache.count_ < FT_PARSER_CACHE_CAPACITY) {
+          ObFTParserCacheEntry &entry = cache.entries_[cache.count_];
+          MEMCPY(entry.name_, parser_name.ptr(), name_len);
+          entry.name_[name_len] = '\0';
+          entry.name_len_ = name_len;
+          entry.ftparser_ = ftparser;
+          entry.param_ = param;
+          entry.library_version_ = library_version;
+          entry.valid_ = true;
+          ++cache.count_;
+        }
+      }
+    }
+  }
+  return ret;
+}
