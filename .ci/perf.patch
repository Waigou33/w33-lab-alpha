+// the depth limit of the match expr tree traversed by the checkers below, a tree deeper than
+// this limit is treated as "the relevance score is needed", which is the conservative result
+static const int64_t MAX_MATCH_SCORE_CHECK_DEPTH = 128;
+
+// check whether `expr` references a match against expression at any position
+static int expr_contains_match_against(const ObRawExpr *expr,
+                                       const int64_t depth,
+                                       bool &found)
+{
+  int ret = OB_SUCCESS;
+  // be conservative: any uncertainty is reported as a reference
+  found = true;
+  if (OB_ISNULL(expr)) {
+    ret = OB_ERR_UNEXPECTED;
+    LOG_WARN("unexpected null expr", K(ret));
+  } else if (OB_UNLIKELY(depth > MAX_MATCH_SCORE_CHECK_DEPTH)) {
+    // keep the conservative result
+  } else {
+    found = expr->is_match_against_expr();
+    for (int64_t i = 0; OB_SUCC(ret) && !found && i < expr->get_param_count(); ++i) {
+      bool child_found = false;
+      if (OB_FAIL(SMART_CALL(expr_contains_match_against(expr->get_param_expr(i), depth + 1, child_found)))) {
+        LOG_WARN("failed to check whether the match expr is referenced", K(ret), K(i));
+      } else if (child_found) {
+        found = true;
+      }
+    }
+  }
+  return ret;
+}
+
+// check whether `expr` uses the match expr as a bare boolean filter only, i.e. the match expr
+// itself or the match expr wrapped by the boolean cast operator
+static int check_match_used_as_filter_only(const ObRawExpr *expr,
+                                           const ObMatchFunRawExpr *match_expr,
+                                           const int64_t depth,
+                                           bool &filter_only)
+{
+  int ret = OB_SUCCESS;
+  filter_only = false;
+  if (OB_ISNULL(expr) || OB_ISNULL(match_expr)) {
+    ret = OB_ERR_UNEXPECTED;
+    LOG_WARN("unexpected null expr", K(ret), KP(expr), KP(match_expr));
+  } else if (OB_UNLIKELY(depth > MAX_MATCH_SCORE_CHECK_DEPTH)) {
+    // keep the conservative result
+  } else if (expr == match_expr) {
+    filter_only = true;
+  } else if (T_OP_BOOL == expr->get_expr_type() && 1 == expr->get_param_count()) {
+    if (OB_FAIL(SMART_CALL(check_match_used_as_filter_only(expr->get_param_expr(0),
+                                                           match_expr,
+                                                           depth + 1,
+                                                           filter_only)))) {
+      LOG_WARN("failed to check whether the match expr is used as a filter only", K(ret));
+    }
+  }
+  return ret;
+}
+
+// Decide whether the relevance score (BM25) of `match_expr` has to be calculated at execution
+// time. The score is skipped only when it can be proved that the match expr is used as a where
+// filter only, i.e. the retrieved documents are exactly the documents accepted by the match, so
+// the query result does not change. In all the other cases the conservative value `true` is kept:
+//   1. the statement is not a select statement: the exprs of the other statements are not
+//      enumerated here, so nothing can be proved;
+//   2. the match mode is not the natural language mode: in the boolean mode (and the other
+//      modes) the score takes part in evaluating the match result;
+//   3. the statement has subqueries: the exprs of the subqueries are not enumerated here;
+//   4. some relation expr outside the where clause references a match expr, e.g. the score is
+//      projected (select list), sorted (order by), aggregated (group by / rollup / having),
+//      evaluated by a window function, used by a join condition / limit / select into, or used
+//      by an expression of a where condition that is not a bare match filter;
+//   5. some where condition references the match expr in a way that is not a bare
+//      `match` / `bool(match)` filter, e.g. `match > 0.5`, `match + 1`, `match or c1 = 1`;
+//   6. the match expr is not found as a where filter at all.
+static int calc_match_score_need_calc(const ObDMLStmt *stmt,
+                                      const ObMatchFunRawExpr *match_expr,
+                                      bool &need_calc)
+{
+  int ret = OB_SUCCESS;
+  need_calc = true;
+  ObSEArray<ObRawExpr *, 16> value_exprs;
+  ObSEArray<ObRawExpr *, 8> where_filters;
+  if (OB_ISNULL(stmt) || OB_ISNULL(match_expr)) {
+    ret = OB_INVALID_ARGUMENT;
+    LOG_WARN("invalid argument", K(ret), KP(stmt), KP(match_expr));
+  } else if (OB_UNLIKELY(!stmt->is_select_stmt())) {
+    LOG_TRACE("not a select statement, keep the relevance calculation", KPC(stmt));
+  } else if (OB_UNLIKELY(NATURAL_LANGUAGE_MODE != match_expr->get_mode_flag())) {
+    LOG_TRACE("not in natural language mode, keep the relevance calculation",
+              K(match_expr->get_mode_flag()), KPC(match_expr));
+  } else if (OB_UNLIKELY(stmt->has_subquery())) {
+    LOG_TRACE("the statement has subqueries, keep the relevance calculation", KPC(stmt));
+  } else if (OB_UNLIKELY(!static_cast<const ObSelectStmt *>(stmt)->get_window_func_exprs().empty())) {
+    // the partition by / order by exprs of a window function are not relation exprs of the stmt,
+    // so they are not enumerated by get_relation_exprs, keep the conservative value
+    LOG_TRACE("the statement has window functions, keep the relevance calculation", KPC(stmt));
+  } else {
+    ObStmtExprGetter value_getter;
+    value_getter.set_relation_scope();
+    value_getter.remove_scope(SCOPE_WHERE);
+    ObStmtExprGetter where_getter;
+    where_getter.remove_all();
+    where_getter.add_scope(SCOPE_WHERE);
+    if (OB_FAIL(stmt->get_relation_exprs(value_exprs, value_getter))) {
+      LOG_WARN("failed to get the relation exprs outside the where clause", K(ret));
+    } else if (OB_FAIL(stmt->get_relation_exprs(where_filters, where_getter))) {
+      LOG_WARN("failed to get the relation exprs of the where clause", K(ret));
+    } else {
+      bool used_as_value = false;
+      for (int64_t i = 0; OB_SUCC(ret) && !used_as_value && i < value_exprs.count(); ++i) {
+        bool found = false;
+        if (OB_FAIL(SMART_CALL(expr_contains_match_against(value_exprs.at(i), 0, found)))) {
+          LOG_WARN("failed to check whether the match score is used as a value", K(ret), K(i));
+        } else if (found) {
+          used_as_value = true;
+        }
+      }
+      bool filter_only = true;
+      bool found_in_where = false;
+      for (int64_t i = 0; OB_SUCC(ret) && filter_only && i < where_filters.count(); ++i) {
+        const ObRawExpr *cond = where_filters.at(i);
+        bool contains_match = false;
+        bool only_filter = false;
+        if (OB_FAIL(SMART_CALL(expr_contains_match_against(cond, 0, contains_match)))) {
+          LOG_WARN("failed to check whether the where filter references the match expr", K(ret), K(i));
+        } else if (!contains_match) {
+          // a normal where filter, it does not use the relevance score
+        } else if (OB_FAIL(SMART_CALL(check_match_used_as_filter_only(cond, match_expr, 0, only_filter)))) {
+          LOG_WARN("failed to check whether the match expr is used as a filter only", K(ret), K(i));
+        } else if (!only_filter) {
+          filter_only = false;
+        } else {
+          found_in_where = true;
+        }
+      }
+      if (OB_SUCC(ret) && !used_as_value && filter_only && found_in_where) {
+        need_calc = false;
+        LOG_TRACE("the match expr is used as a where filter only, no need to calculate relevance",
+                  KPC(match_expr));
+      }
+    }
+  }
+  return ret;
+}
