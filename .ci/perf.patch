+/**
+ * Cache of the "inner" fulltext parser name.
+ *
+ * @details construct_ft_parser_inner_name() turns the parser name given by the user
+ * (e.g. "ik") into "<lowercased name>.<plugin library version>" (e.g. "ik.1") by looking
+ * the plugin up and serializing the result. That transformation only depends on the input
+ * bytes and on the plugin registration, both of which are stable for the process
+ * lifetime, so the produced bytes can be memoized and handed out again.
+ *
+ * Correctness notes:
+ *  - only a *successful* conversion is stored, so a failing input always goes through the
+ *    original code path and reports the original error code and user error;
+ *  - the key is the raw parser name compared byte by byte against the exact bytes that
+ *    produced the entry, so a hit re-produces a byte identical string;
+ *  - published entries are immutable and live as long as the process, so
+ *    TokenizeParam::parser_name_ may point into the cache (it is only ever read);
+ *  - a full cache simply falls back to the original code path.
+ */
+struct TokenizeParserNameEntry
+{
+  TokenizeParserNameEntry() : valid_(false), raw_len_(0), inner_len_(0)
+  {
+    MEMSET(raw_, '\0', share::OB_PLUGIN_NAME_LENGTH);
+    MEMSET(inner_, '\0', share::OB_PLUGIN_NAME_LENGTH);
+  }
+  bool valid_;
+  int64_t raw_len_;
+  int64_t inner_len_;
+  char raw_[share::OB_PLUGIN_NAME_LENGTH];
+  char inner_[share::OB_PLUGIN_NAME_LENGTH];
+};
+
+constexpr int64_t TOKENIZE_PARSER_NAME_CACHE_CAPACITY = 16;
+
+struct TokenizeParserNameCache
+{
+  TokenizeParserNameCache() : count_(0) {}
+  common::ObSpinLock lock_;
+  int64_t count_;
+  TokenizeParserNameEntry entries_[TOKENIZE_PARSER_NAME_CACHE_CAPACITY];
+};
+
+TokenizeParserNameCache &get_tokenize_parser_name_cache()
+{
+  static TokenizeParserNameCache cache;
+  return cache;
+}
