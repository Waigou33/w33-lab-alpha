+// Hands back the token map that this call has to fill.
+//   * scratch == nullptr: historical behaviour -- a map owned by this call only.
+//   * scratch != nullptr: the map of the scan operator, created once and reused for every
+//     document. Reusing it cannot change the produced (word -> count) pairs: a hash map's
+//     content is independent of its bucket count and of the words it held before, and
+//     ObFTParseHelper::segment() clears it (words.reuse()) before inserting this
+//     document's first word.
+static int prepare_ft_word_map(ObFTWordRowScratch *scratch,
+                               ObFTWordMap &per_call_word_map,
+                               const int64_t bucket_cnt)
+{
+  int ret = OB_SUCCESS;
+  if (OB_NOT_NULL(scratch)) {
+    // per_call_word_map is unused here; the caller passes scratch->get_word_map()
+    ret = scratch->ensure_word_map(bucket_cnt);
+  } else {
+    // unchanged relative to the pre-optimization code, including the memory label
+    ret = per_call_word_map.create(bucket_cnt, common::ObMemAttr("FTWordMap"));
+  }
+  return ret;
+}
+
+// Hands back a row buffer able to hold row_cnt rows.
+// need_init tells the caller whether the rows still have to be inited: only the rows
+// allocated right here (scratch == nullptr) do -- a reusable buffer was inited once, when
+// it was allocated, with the same (constant) column count.
+static int prepare_ft_row_buffer(common::ObIAllocator &allocator,
+                                 ObFTWordRowScratch *scratch,
+                                 const int64_t row_cnt,
+                                 blocksstable::ObDatumRow *&rows,
+                                 bool &need_init)
+{
+  int ret = OB_SUCCESS;
+  rows = nullptr;
+  need_init = false;
+  if (OB_NOT_NULL(scratch)) {
+    if (OB_FAIL(scratch->ensure_row_buffer(row_cnt, rows))) {
+      LOG_WARN("fail to prepare reusable fulltext word rows buffer", K(ret), K(row_cnt));
+    }
+  } else {
+    void *rows_buf = nullptr;
+    if (OB_ISNULL(rows_buf = reinterpret_cast<char *>(
+                      allocator.alloc(row_cnt * sizeof(blocksstable::ObDatumRow))))) {
+      ret = OB_ALLOCATE_MEMORY_FAILED;
+      LOG_WARN("failed to alloc memory for full text index rows buffer", K(ret));
+    } else {
+      rows = new (rows_buf) blocksstable::ObDatumRow[row_cnt];
+      need_init = true;
+    }
+  }
+  return ret;
+}
